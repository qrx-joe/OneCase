{
  "name": "onecase-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "OneCase - 社区事项 AI 工作台",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @onecase/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @onecase/web test:e2e",
    "test:e2e:ui": "pnpm --filter @onecase/web test:e2e:ui",
    "db:push": "pnpm --filter @onecase/db push",
    "db:studio": "pnpm --filter @onecase/db studio",
    "db:generate": "pnpm --filter @onecase/db generate"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "prettier": "^3.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
